# Optional Docker Compose settings. Native Devloom reads shell variables only.
DEVLOOM_PORT=4310
DEVLOOM_OTLP_PORT=4318
# Required for Docker Compose. Set your own credentials before starting.
DEVLOOM_AUTH_USERNAME=admin
DEVLOOM_AUTH_PASSWORD=
# Optional image name, e.g. your-dockerhub-user/devloom:latest
# DEVLOOM_IMAGE=devloom:local
# Required only with -f compose.projects.yaml:
# DEVLOOM_PROJECTS_DIR=/absolute/path/to/projects
